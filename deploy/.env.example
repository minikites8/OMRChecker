# External values are injected through the deployment environment.
OMR_AUTH_MODE=oidc_or_builtin
OMR_PERSISTENCE_MODE=postgres_cos
OMR_SESSION_SECRET=replace-with-a-long-random-value
OMR_PUBLIC_BASE_URL=http://localhost:8765
OMR_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OMR_BOOTSTRAP_ADMIN_PASSWORD=replace-before-start

DATABASE_URL=postgresql://omrchecker:replace-password@postgres:5432/omrchecker
FRONTEND_ORIGINS=http://localhost:8765

OIDC_ISSUER_URL=https://id.example.com
OIDC_CLIENT_ID=omrchecker
OIDC_CLIENT_SECRET=replace-with-oidc-secret
OIDC_REDIRECT_URI=http://localhost:8765/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_DEFAULT_ROLE=teacher

TENCENT_COS_SECRET_ID=replace-with-cos-secret-id
TENCENT_COS_SECRET_KEY=replace-with-cos-secret-key
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=replace-with-bucket-name
TENCENT_COS_APPID=replace-with-appid
TENCENT_COS_PREFIX=omrchecker
